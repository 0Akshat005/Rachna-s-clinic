# Copy to .env.local. Never commit secrets.
# Preview submits to the API but sends/stores no contact details.
BOOKING_MODE=preview
SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLINIC_FACTS_APPROVED=false
NEXT_PUBLIC_INDEXING_ENABLED=false
RESEND_API_KEY=
BOOKING_FROM_EMAIL=
BOOKING_TO_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BOOKING_HASH_SECRET=
